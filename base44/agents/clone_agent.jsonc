      "description": "Full-site clone engine \u2014 crawls all pages (BFS), re-hosts images, inlines CSS, rewrites links, injects AI tools + checkout + search + forms, deploys to Vercel + provisions GitHub/Supabase/Drive."
    },
    {
      "function_name": "resolveDeepPath",
      "description": "On-demand deep path resolver \u2014 clones a specific Envato category page that wasn't pre-crawled. Used to verify deep path resolution works."
    },
    {
      "function_name": "cleanupOrphanedVercelProjects",
      "description": "Delete orphaned Vercel projects to free deployment quota before cloning if needed."
    }
