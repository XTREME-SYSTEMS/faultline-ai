      "description": "Run forensic security audit on the Envato clone \u2014 checks security headers, compliance, structural integrity. Returns forensic score 0-100."
    },
    {
      "function_name": "validateFullStack",
      "description": "Validate visual and operational parity of the Envato clone vs elements.envato.com. Returns visual_score, operational_score, overall score."
    },
    {
      "function_name": "recursiveEndToEndValidator",
      "description": "Recursively crawl and test every page, all 8 AI tools, all 5 Stripe checkouts, and form handler on the Envato clone."
    },
    {
      "function_name": "resolveDeepPath",
      "description": "Dynamically fetch and clone a deep Envato category path that wasn't pre-crawled. Tests on-demand path resolution."
    },
