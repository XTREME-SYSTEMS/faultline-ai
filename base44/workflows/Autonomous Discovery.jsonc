{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_discovery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "discover": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "discoverCompanies"
          },
          "then": "end",
          "x-base44": {
            "title": "Discover companies",
            "description": "Web search for new businesses"
          }
        }
      }
    ]
  },
  "description": "Daily autonomous discovery of new businesses via web search, populating the company database for scanning.",
  "name": "Autonomous Discovery",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}