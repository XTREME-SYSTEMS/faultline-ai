{
  "name": "Autonomous Headless Scanner",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_headless_scanner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousHeadlessScan"
          },
          "then": "end",
          "x-base44": {
            "title": "Run headless tests on all generated systems",
            "description": "Client-POV scan of every deliverable"
          }
        }
      }
    ]
  },
  "description": "Continuously scans the frontend and backend of every generated system from the client's perspective \u2014 runs a headless user-POV test on each Deliverable every 6 hours and stores the results as QA reports.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 6,
      "interval_unit": "hours",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}