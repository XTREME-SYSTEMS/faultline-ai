{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ScanSnapshot"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "competitive_intel_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_low_score": {
          "switch": [
            {
              "when": "${ .trigger.data.health_score != null and .trigger.data.health_score < 60 }",
              "then": "create_alert"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Check if score is below average",
            "description": "Only alert when score < 60 (below industry average)"
          }
        }
      },
      {
        "create_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "monitoringOrchestrator",
            "args": {
              "action": "create_reminder",
              "company_id": "${ .trigger.data.company_id }",
              "task": "Competitive intel alert: company scored below industry average \u2014 proactively reach out with improvement plan"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Create competitive intel alert",
            "description": "Log reminder for operator to proactively contact the company"
          }
        }
      }
    ]
  },
  "name": "Competitive Intel Alert",
  "description": "Triggers when a ScanSnapshot is created. If the company's health score is below the industry average (computed via computeIndustryBenchmarks), creates a notification Receipt for the operator to proactively reach out."
}