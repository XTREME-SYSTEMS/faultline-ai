{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rescan_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "rescan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "rescanMonitor"
          },
          "then": "end",
          "x-base44": {
            "title": "Re-scan companies",
            "description": "Monthly monitoring"
          }
        }
      }
    ]
  },
  "name": "Re-scan Monitor",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 1 * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Monthly re-scan of companies to detect score changes and new critical findings"
}