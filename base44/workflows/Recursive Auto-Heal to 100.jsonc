{
  "description": "Scheduled 24/7 autonomous loop: batch-heals ALL launched clones below 100/100 parity in a single pass \u2014 validate, auto-fix, re-deploy, re-validate \u2014 until 100/100 visual + operational parity is reached across the entire catalog.",
  "name": "Recursive Auto-Heal to 100",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-08T09:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recursive_auto_heal_to_100",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "batch_heal_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "healAllClonesTo100",
            "args": {
              "max_iterations": 3
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Batch heal ALL clones to 100",
            "description": "Heal every launched clone below 100/100 in one batch pass"
          }
        }
      }
    ]
  }
}