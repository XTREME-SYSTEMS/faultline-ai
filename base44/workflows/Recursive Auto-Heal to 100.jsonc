{
  "description": "Scheduled 24/7 autonomous loop: every 30 min \u2014 batch-heals ALL launched clones to 100/100 parity, then runs a deep forensic audit (security headers, HTML structure, form handlers, content depth), auto-fixes, auto-hardens, and re-validates. Sites still failing get re-healed on the next cycle until every cloned site passes both parity AND forensic checks at 100/100.",
  "name": "Recursive Auto-Heal to 100",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-08T09:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recursive_auto_heal_to_100",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "batch_heal_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "healAllClonesTo100",
            "args": {
              "max_iterations": 3
            }
          },
          "then": "forensic_audit",
          "x-base44": {
            "title": "Batch heal all clones to 100",
            "description": "Heal every launched clone below 100/100 parity"
          }
        }
      },
      {
        "forensic_audit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "forensicAuditAndHarden",
            "args": {
              "max_iterations": 2
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Deep forensic audit + harden",
            "description": "Security headers, HTML structure, form handlers \u2014 auto-fix + auto-harden + re-validate"
          }
        }
      }
    ]
  }
}