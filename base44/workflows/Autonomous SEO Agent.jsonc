{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_seo_agent",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_full_audit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousSeoAgent",
            "args": {
              "action": "full_audit"
            }
          },
          "then": "generate_location_pages",
          "x-base44": {
            "title": "Run full SEO/AEO audit",
            "description": "Comprehensive audit with keyword opportunities and prioritized action plan"
          }
        }
      },
      {
        "generate_location_pages": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousSeoAgent",
            "args": {
              "action": "generate_location_pages"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate location pages",
            "description": "Bulk-generate SEO content for all service areas"
          }
        }
      }
    ]
  },
  "name": "Autonomous SEO Agent",
  "description": "Daily autonomous SEO/AEO enhancement for Epoxy Garage Floors Near You \u2014 runs full audit, generates content recommendations, monitors keywords, and stores results for persistent ranking improvement",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}