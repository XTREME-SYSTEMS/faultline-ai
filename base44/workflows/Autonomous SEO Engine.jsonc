{
  "name": "Autonomous SEO Engine",
  "description": "Runs the full autonomous SEO pipeline every 2 hours for all enabled sites: crawl \u2192 generate tags \u2192 inject via GitHub \u2192 setup GA4 \u2192 submit to Search Console \u2192 track rankings. Ensures every site is optimized and ranking as fast as possible.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": 2,
      "interval_unit": "hours",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_seo_engine",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_seo_engine": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousSEOEngine",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run autonomous SEO pipeline",
            "description": "Crawl \u2192 generate tags \u2192 inject \u2192 setup GA \u2192 submit to Search Console \u2192 track rankings for all enabled sites"
          }
        }
      }
    ]
  }
}