{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weeklyDigest"
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly digest",
            "description": "Email summary to admin"
          }
        }
      }
    ]
  },
  "name": "Weekly Digest",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sends a weekly digest email summarizing new findings, score changes, and recommended actions"
}