{
  "description": "Master nightly autonomous operations loop. Runs every 30 minutes. Each cycle: (1) heal all clones to 100/100 parity, (2) forensic audit + harden security, (3) stock the marketplace with new products, (4) discover new top-performer sites to clone, (5) process the clone queue (drain queued sites), (6) process the epoxy contractor batch, (7) derive reusable templates from finished 100/100 clones, (8) cleanup orphaned Vercel projects. The system self-heals, self-audits, self-stocks, self-discovers, self-drains, self-templates, and self-cleans autonomously overnight.",
  "name": "Nightly Autonomous Operations",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-09T04:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_autonomous_operations",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "heal_all_clones": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "healAllClonesTo100",
            "args": {
              "max_iterations": 3,
              "batch_limit": 2
            }
          },
          "then": "forensic_audit",
          "x-base44": {
            "title": "Heal all clones to 100/100",
            "description": "Batch-heal every launched clone below 100/100 parity"
          }
        }
      },
      {
        "forensic_audit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "forensicAuditAndHarden",
            "args": {
              "max_iterations": 2,
              "heal_limit": 2
            }
          },
          "then": "stock_marketplace",
          "x-base44": {
            "title": "Forensic audit + harden",
            "description": "Deep security audit, auto-fix, auto-harden, re-validate all clones"
          }
        }
      },
      {
        "stock_marketplace": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousMarketplaceStocker",
            "args": {
              "max_per_run": 20
            }
          },
          "then": "discover_performers",
          "x-base44": {
            "title": "Stock marketplace products",
            "description": "Generate and stock concrete-industry products (AI tools, web packs, app packs, CRMs)"
          }
        }
      },
      {
        "discover_performers": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "discoverTopPerformers",
            "args": {}
          },
          "then": "process_queue",
          "x-base44": {
            "title": "Discover new top performers",
            "description": "Find new top-performing sites to clone for the marketplace"
          }
        }
      },
      {
        "process_queue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processCloneQueue",
            "args": {}
          },
          "then": "process_epoxy_batch",
          "x-base44": {
            "title": "Process clone queue",
            "description": "Drain the CloneQueue \u2014 clone queued sites, audit, and launch"
          }
        }
      },
      {
        "process_epoxy_batch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processEpoxyBatch",
            "args": {
              "max_items": 2
            }
          },
          "then": "derive_templates",
          "x-base44": {
            "title": "Process epoxy contractor batch",
            "description": "Dedicated processor for the top-20 epoxy contractor clone batch \u2014 bypasses the general backlog"
          }
        }
      },
      {
        "derive_templates": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deriveTemplatesFromClones",
            "args": {
              "limit": 5
            }
          },
          "then": "cleanup_vercel",
          "x-base44": {
            "title": "Derive templates from clones",
            "description": "Auto-derive reusable WebsiteTemplate records from 100/100 parity clones (including finished epoxy clones)"
          }
        }
      },
      {
        "cleanup_vercel": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cleanupOrphanedVercelProjects",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Cleanup orphaned Vercel projects",
            "description": "Delete Vercel projects from heal iterations no longer referenced by any LaunchProject"
          }
        }
      }
    ]
  }
}