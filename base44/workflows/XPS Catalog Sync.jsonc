{
  "name": "XPS Catalog Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "xps_catalog_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scrapeXpsCatalog",
            "args": {
              "maxPages": 5
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync XPS catalog",
            "description": "Scrape & upsert products"
          }
        }
      }
    ]
  },
  "description": "Weekly automated scrape of the Xtreme Polishing Systems product catalog and upsert into the Product entity"
}