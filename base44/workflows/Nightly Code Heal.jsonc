{
  "name": "Nightly Code Heal",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_code_heal",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_code_heal": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousCodeHeal",
            "args": {
              "max_iterations": 5,
              "max_sites": 10
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run autonomous code heal",
            "description": "Fix all sites below 100/100 recursively"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Autonomous code implementation loop \u2014 runs every night at 2am ET. Creates a to-do list per site, generates targeted code fixes via LLM, deploys, validates, and recurses until 100/100 visual + operational parity."
}