{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "page_token": {
      "type": "string"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "drive_folder_id": {
      "type": "string"
    },
    "last_direction": {
      "type": "string",
      "enum": [
        "export",
        "import"
      ]
    },
    "last_count": {
      "type": "number"
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}