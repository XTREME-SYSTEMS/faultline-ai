{
  "name": "ActivityReceipt",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "photo",
        "mask",
        "visualization",
        "quote",
        "proposal",
        "appointment",
        "validation",
        "audit"
      ],
      "default": "audit"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}