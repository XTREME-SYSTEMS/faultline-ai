{
  "name": "PricingProfile",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "labor_rate_per_hr": {
      "type": "number"
    },
    "crew_size": {
      "type": "number"
    },
    "fuel_rate_per_mile": {
      "type": "number"
    },
    "avg_travel_miles": {
      "type": "number"
    },
    "material_markup_pct": {
      "type": "number"
    },
    "mobilization_fee": {
      "type": "number"
    },
    "overhead_pct": {
      "type": "number"
    },
    "profit_pct": {
      "type": "number"
    },
    "base_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "rate_low": {
            "type": "number"
          },
          "rate_high": {
            "type": "number"
          }
        }
      }
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "company_name",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}