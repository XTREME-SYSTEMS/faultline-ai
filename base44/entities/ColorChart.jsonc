{
  "name": "ColorChart",
  "type": "object",
  "properties": {
    "system": {
      "type": "string",
      "enum": [
        "metallic",
        "flake",
        "quartz",
        "solid",
        "glitter",
        "dye_stain",
        "joint_filler"
      ]
    },
    "color_name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "hex": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Official manufacturer product/swatch photo"
    },
    "collection": {
      "type": "string",
      "description": "e.g. Top 12, Standard, Ameripolish, In-Stock, Warm, Cool"
    },
    "sheen": {
      "type": "string",
      "description": "Finish sheen level: Matte, Satin, Semi-Gloss, High Gloss, or multiple",
      "default": "High Gloss"
    },
    "product_sku": {
      "type": "string",
      "description": "Linked Product entity SKU"
    },
    "rank": {
      "type": "number",
      "description": "Popularity rank from the published chart, 1-based"
    },
    "in_stock": {
      "type": "boolean",
      "default": false
    },
    "vendor": {
      "type": "string",
      "default": "Xtreme Polishing Systems"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "system",
    "color_name",
    "code",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}