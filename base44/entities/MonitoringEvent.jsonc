{
  "name": "MonitoringEvent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "monitoring_rule_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "monitoring_rule_id",
    "event_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}