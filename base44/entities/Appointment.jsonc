{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "requested_window": {
      "type": "string",
      "enum": [
        "morning",
        "midday",
        "afternoon",
        "evening"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "consultation",
        "site_visit",
        "virtual"
      ],
      "default": "consultation"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "confirmed",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "requested"
    },
    "message": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}