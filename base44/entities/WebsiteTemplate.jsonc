{
  "name": "WebsiteTemplate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Template display name (e.g. 'Modern SaaS Landing')"
    },
    "source_clone_id": {
      "type": "string",
      "description": "LaunchProject ID the template was derived from"
    },
    "source_clone_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "layout_type": {
      "type": "string",
      "enum": [
        "hero_centric",
        "split_hero",
        "grid",
        "magazine",
        "dashboard",
        "portfolio",
        "ecommerce",
        "landing_page",
        "agency",
        "blog"
      ],
      "default": "hero_centric"
    },
    "layout_description": {
      "type": "string",
      "description": "Human-readable layout description"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of page sections (e.g. ['Hero','Features','Testimonials','Pricing','CTA','Footer'])"
    },
    "color_palette": {
      "type": "object",
      "description": "Extracted colors from the source clone",
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "suggested_accents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hex colors that work well as accents with this layout"
    },
    "font_pairings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "vibe": {
            "type": "string"
          }
        }
      },
      "description": "Recommended heading + body font pairings"
    },
    "screenshot_url": {
      "type": "string",
      "description": "Screenshot of the source clone"
    },
    "preview_url": {
      "type": "string",
      "description": "Live Vercel URL of the source clone"
    },
    "html_file_url": {
      "type": "string",
      "description": "File URL to the template HTML (with placeholders)"
    },
    "target_audience": {
      "type": "string"
    },
    "tone": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "usage_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "name",
    "layout_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}