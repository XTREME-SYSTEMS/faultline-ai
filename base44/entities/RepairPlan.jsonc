{
  "name": "RepairPlan",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "audit_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "horizon_days": {
      "type": "number"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "audit_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}