{
  "name": "RepairPlan",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "audit_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "horizon_days": {
      "type": "number"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "audit_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}