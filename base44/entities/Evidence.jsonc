{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "audit_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_uri": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_summary": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "audit_id",
    "source_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}