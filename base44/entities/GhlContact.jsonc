{
  "name": "GhlContact",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "qualified",
        "proposal",
        "won",
        "lost",
        "active"
      ],
      "default": "lead"
    },
    "source": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "avatar_color": {
      "type": "string"
    },
    "custom_fields": {
      "type": "object"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}