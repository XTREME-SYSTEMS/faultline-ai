{
  "name": "SystemHealthScore",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "overall_score": {
      "type": "number",
      "description": "Aggregate 0-100 health score"
    },
    "security_score": {
      "type": "number"
    },
    "functionality_score": {
      "type": "number"
    },
    "performance_score": {
      "type": "number"
    },
    "autonomy_score": {
      "type": "number"
    },
    "qa_pass_rate": {
      "type": "number",
      "description": "Percentage of QAReports with passed/warnings status"
    },
    "function_success_rate": {
      "type": "number",
      "description": "Percentage of backend functions returning 200"
    },
    "headless_pass_rate": {
      "type": "number"
    },
    "rls_coverage": {
      "type": "number",
      "description": "Percentage of entities with org-scoped RLS"
    },
    "trend": {
      "type": "string",
      "enum": [
        "improving",
        "stable",
        "declining"
      ]
    },
    "hardening_actions_count": {
      "type": "number",
      "default": 0
    },
    "last_hardened_at": {
      "type": "string",
      "format": "date-time"
    },
    "active_remediation": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "organization_id",
    "overall_score"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}