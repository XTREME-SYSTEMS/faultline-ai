{
  "name": "RepairAction",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "repair_plan_id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "priority": {
      "type": "number"
    },
    "owner_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validation_result": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "repair_plan_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}