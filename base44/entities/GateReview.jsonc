{
  "name": "GateReview",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "ClientProject ref"
    },
    "gate_slug": {
      "type": "string"
    },
    "gate_title": {
      "type": "string"
    },
    "gate_index": {
      "type": "number"
    },
    "deliverable_id": {
      "type": "string",
      "description": "Deliverable ref presented"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "fix_requested",
        "revised"
      ],
      "default": "pending"
    },
    "fix_responses": {
      "type": "object",
      "description": "Multiple-choice answers + open feedback from the client"
    },
    "decision_note": {
      "type": "string"
    },
    "iteration": {
      "type": "number",
      "default": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "project_id",
    "gate_slug",
    "state"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}