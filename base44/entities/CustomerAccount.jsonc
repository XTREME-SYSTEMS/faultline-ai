{
  "name": "CustomerAccount",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "pre_launch",
        "early_revenue",
        "growth",
        "established",
        "commercial"
      ],
      "default": "pre_launch"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "suspended",
        "churned"
      ],
      "default": "trial"
    },
    "owner_user_id": {
      "type": "string"
    },
    "lifecycle_state": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "account_name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}