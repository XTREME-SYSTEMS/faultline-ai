{
  "name": "SystemNode",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "node_type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "health_status": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "company_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}