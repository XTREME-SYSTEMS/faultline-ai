{
  "name": "UniversalCatalog",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Top-level discovery category (epoxy_metallic, construction_data, ai_tools, etc.)"
    },
    "subcategory": {
      "type": "string"
    },
    "niche": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "platform",
        "online_store",
        "ai_tool",
        "ai_template",
        "web_pack",
        "app_pack",
        "scraper",
        "agent",
        "orchestrator",
        "contractor_website",
        "data_platform",
        "lead_gen_system",
        "crm",
        "estimating_tool",
        "project_management",
        "seo_platform",
        "website_generator",
        "app_generator",
        "other"
      ]
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "revenue_model": {
      "type": "string"
    },
    "target_audience": {
      "type": "string"
    },
    "value_proposition": {
      "type": "string"
    },
    "key_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superiority_strategy": {
      "type": "object"
    },
    "analysis_data": {
      "type": "object"
    },
    "discovery_source": {
      "type": "string",
      "default": "llm_web_search"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "pending",
        "validated",
        "failed",
        "needs_work"
      ],
      "default": "pending"
    },
    "validation_notes": {
      "type": "string"
    },
    "clone_status": {
      "type": "string",
      "enum": [
        "discovered",
        "queued",
        "cloning",
        "cloned",
        "launched",
        "not_applicable"
      ],
      "default": "discovered"
    },
    "clone_artifact_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "profit_potential": {
      "type": "string",
      "enum": [
        "very_high",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "category",
    "item_type",
    "name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}