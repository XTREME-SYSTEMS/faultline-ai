{
  "name": "GhlOpportunity",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "pipeline_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "value": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "won",
        "lost"
      ],
      "default": "open"
    },
    "expected_close": {
      "type": "string",
      "format": "date"
    },
    "probability": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "title",
    "pipeline_id",
    "stage"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}