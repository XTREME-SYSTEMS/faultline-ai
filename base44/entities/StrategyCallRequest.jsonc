{
  "name": "StrategyCallRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "service": {
      "type": "string",
      "description": "Consultation service requested (ai_tools, website, app, audit, security, consulting)"
    },
    "industry": {
      "type": "string",
      "description": "Client industry (epoxy, polished_concrete, decorative_concrete, other)"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "preferred_time": {
      "type": "string",
      "description": "Selected time slot label"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "new"
    },
    "source": {
      "type": "string",
      "default": "consultation"
    }
  },
  "required": [
    "name",
    "email",
    "company",
    "service"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}