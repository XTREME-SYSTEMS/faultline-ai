{
  "name": "LaunchProject",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "website",
        "app",
        "system"
      ],
      "default": "website"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "generating",
        "provisioning",
        "validating",
        "testing",
        "passed",
        "failed",
        "retrying",
        "cancelled"
      ],
      "default": "queued"
    },
    "design_pack_id": {
      "type": "string"
    },
    "design_pack_image_url": {
      "type": "string"
    },
    "deliverable_id": {
      "type": "string"
    },
    "customer_account_id": {
      "type": "string",
      "description": "CRM CustomerAccount ref"
    },
    "company_id": {
      "type": "string",
      "description": "Company ref"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target_audience": {
      "type": "string"
    },
    "tone": {
      "type": "string",
      "default": "professional"
    },
    "drive_folder_url": {
      "type": "string"
    },
    "github_repo_url": {
      "type": "string"
    },
    "supabase_project_url": {
      "type": "string"
    },
    "vercel_project_url": {
      "type": "string"
    },
    "vercel_deployment_url": {
      "type": "string"
    },
    "domain_name": {
      "type": "string"
    },
    "benchmark_url": {
      "type": "string",
      "description": "Target benchmark site URL for comparison"
    },
    "benchmark_report": {
      "type": "object",
      "description": "Exhaustive discovery + audit report on the benchmark site (financial, strategy, niche, stack, target market, AI enhancement, profit margin, customer base, monetization, etc.)"
    },
    "parity_score": {
      "type": "number"
    },
    "operational_score": {
      "type": "number"
    },
    "test_score": {
      "type": "number"
    },
    "progress": {
      "type": "number",
      "description": "Real-time pipeline progress 0-100, written by the autonomous engine at each stage",
      "default": 0
    },
    "mandatory_passed": {
      "type": "boolean",
      "default": false
    },
    "qa_report_id": {
      "type": "string"
    },
    "iteration": {
      "type": "number",
      "default": 0
    },
    "last_validation_summary": {
      "type": "string"
    },
    "errors": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "project_name",
    "project_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}