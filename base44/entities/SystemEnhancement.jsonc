{
  "name": "SystemEnhancement",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "enhancement_id": {
      "type": "string",
      "description": "Unique slug e.g. SCRAPE-01, CLONE-03"
    },
    "pillar": {
      "type": "string",
      "enum": [
        "scraping",
        "cloning",
        "generation",
        "speed_efficiency",
        "capabilities",
        "forensic_audit",
        "system_validation"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "technology": {
      "type": "string",
      "description": "The specific technology/approach that delivers this enhancement"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "high"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "implemented",
        "validated",
        "audited",
        "failed",
        "deferred"
      ],
      "default": "pending"
    },
    "implementation_notes": {
      "type": "string"
    },
    "validation_result": {
      "type": "string",
      "enum": [
        "not_started",
        "pass",
        "fail",
        "needs_work"
      ],
      "default": "not_started"
    },
    "validation_notes": {
      "type": "string"
    },
    "audit_result": {
      "type": "string",
      "enum": [
        "not_started",
        "pass",
        "fail",
        "needs_work"
      ],
      "default": "not_started"
    },
    "audit_notes": {
      "type": "string"
    },
    "iteration_count": {
      "type": "number",
      "default": 0
    },
    "files_touched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "enhancement_ids this depends on"
    }
  },
  "required": [
    "organization_id",
    "enhancement_id",
    "pillar",
    "title",
    "description"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}