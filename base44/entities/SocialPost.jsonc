{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram",
        "twitter",
        "linkedin",
        "tiktok"
      ],
      "default": "facebook"
    },
    "page_id": {
      "type": "string",
      "description": "Platform page/account ID"
    },
    "page_name": {
      "type": "string"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "text",
        "link",
        "photo",
        "video"
      ],
      "default": "text"
    },
    "content": {
      "type": "string",
      "description": "Post text/caption"
    },
    "link_url": {
      "type": "string"
    },
    "media_url": {
      "type": "string",
      "description": "Image or video URL to attach"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "publishing",
        "published",
        "failed"
      ],
      "default": "draft"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time"
    },
    "published_time": {
      "type": "string",
      "format": "date-time"
    },
    "platform_post_id": {
      "type": "string",
      "description": "ID returned by the platform"
    },
    "insights": {
      "type": "object",
      "description": "Engagement metrics from the platform"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "platform",
    "content"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}