{
  "name": "ContractorService",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "segment": {
      "type": "string",
      "description": "e.g. Polished Concrete, Epoxy Flooring"
    },
    "description": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}