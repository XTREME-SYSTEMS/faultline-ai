{
  "name": "OutreachDraft",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array"
    },
    "approval_status": {
      "type": "string"
    },
    "send_status": {
      "type": "string",
      "enum": [
        "draft_only",
        "approved_for_send"
      ],
      "default": "draft_only"
    }
  },
  "required": [
    "organization_id",
    "company_id",
    "subject",
    "body"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}