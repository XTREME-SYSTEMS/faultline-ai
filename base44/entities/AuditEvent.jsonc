{
  "name": "AuditEvent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "actor_user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "create, update, delete, approve, reject, publish, etc"
    },
    "before": {
      "type": "object"
    },
    "after": {
      "type": "object"
    },
    "receipt_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "entity_type",
    "entity_id",
    "action"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}