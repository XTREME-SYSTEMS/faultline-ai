{
  "name": "ProductPackage",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website_tier": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Ready"
      ],
      "default": "Draft"
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}