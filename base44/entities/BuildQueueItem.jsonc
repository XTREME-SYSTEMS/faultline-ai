{
  "name": "BuildQueueItem",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "generator_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "build_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "position": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "analyzing",
        "planning",
        "building",
        "connecting",
        "testing",
        "repairing",
        "waiting_input",
        "waiting_connector",
        "failed",
        "completed",
        "paused",
        "cancelled"
      ],
      "default": "queued"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "current_step": {
      "type": "string"
    },
    "required_connectors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "max_retries": {
      "type": "number",
      "default": 3
    },
    "blocked_reason": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "output_refs": {
      "type": "object"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "organization_id",
    "name",
    "build_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}