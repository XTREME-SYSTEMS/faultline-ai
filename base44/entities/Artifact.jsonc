{
  "name": "Artifact",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "generator_id": {
      "type": "string"
    },
    "queue_item_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "website",
        "app",
        "business_system",
        "document",
        "brand",
        "financial_model",
        "marketing_plan",
        "operations_manual",
        "launch_package",
        "blueprint",
        "report"
      ]
    },
    "storage_url": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Inline content for smaller artifacts"
    },
    "hash": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "validated",
        "approved",
        "published",
        "failed"
      ],
      "default": "generated"
    },
    "metadata": {
      "type": "object"
    },
    "validation_score": {
      "type": "number"
    }
  },
  "required": [
    "organization_id",
    "name",
    "artifact_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}