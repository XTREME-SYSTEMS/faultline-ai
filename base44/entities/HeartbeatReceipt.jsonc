{
  "name": "HeartbeatReceipt",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "heartbeat_time": {
      "type": "string",
      "format": "date-time"
    },
    "build_id": {
      "type": "string"
    },
    "queue_depth": {
      "type": "number",
      "default": 0
    },
    "current_task": {
      "type": "string"
    },
    "completed_since_last": {
      "type": "number",
      "default": 0
    },
    "new_defects": {
      "type": "number",
      "default": 0
    },
    "closed_defects": {
      "type": "number",
      "default": 0
    },
    "current_lowest_score": {
      "type": "number"
    },
    "route_coverage": {
      "type": "number"
    },
    "taxonomy_coverage": {
      "type": "number"
    },
    "backend_coverage": {
      "type": "number"
    },
    "content_coverage": {
      "type": "number"
    },
    "interaction_coverage": {
      "type": "number"
    },
    "visual_score": {
      "type": "number"
    },
    "route_taxonomy_validation": {
      "type": "number",
      "description": "Percentage of discovered content routes cross-referenced and confirmed against the EnvatoTaxonomyLedger"
    },
    "route_discovery_coverage": {
      "type": "number",
      "description": "P6: Percentage of expected public surface routes discovered"
    },
    "route_to_taxonomy_match": {
      "type": "number",
      "description": "P6: Percentage of content routes matched to taxonomy nodes (post-normalization)"
    },
    "taxonomy_node_validation": {
      "type": "number",
      "description": "P6: Percentage of taxonomy nodes validated against source evidence"
    },
    "taxonomy_route_coverage": {
      "type": "number",
      "description": "P6: Percentage of valid taxonomy nodes with a corresponding route"
    },
    "content_family_coverage": {
      "type": "number",
      "description": "P6: Percentage of taxonomy leaf nodes with sufficient content"
    },
    "backend_capability_coverage": {
      "type": "number",
      "description": "P6: Percentage of backend capabilities implemented"
    },
    "pre_normalization_match_rate": {
      "type": "number",
      "description": "Route-to-taxonomy match rate before URL normalization"
    },
    "post_normalization_match_rate": {
      "type": "number",
      "description": "Route-to-taxonomy match rate after URL normalization"
    },
    "discovered_routes": {
      "type": "number"
    },
    "valid_routes": {
      "type": "number"
    },
    "matched_routes": {
      "type": "number"
    },
    "unmatched_routes": {
      "type": "number"
    },
    "total_taxonomy_nodes": {
      "type": "number"
    },
    "validated_taxonomy_nodes": {
      "type": "number"
    },
    "orphan_nodes": {
      "type": "number"
    },
    "invalid_nodes": {
      "type": "number"
    },
    "missing_route_nodes": {
      "type": "number"
    },
    "missing_content_nodes": {
      "type": "number"
    },
    "delta_from_previous": {
      "type": "object",
      "description": "P13: Delta of key metrics from previous heartbeat \u2014 regression detection"
    },
    "security_status": {
      "type": "string",
      "enum": [
        "secure",
        "warning",
        "critical"
      ],
      "default": "secure"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_task": {
      "type": "string"
    },
    "next_work_packet": {
      "type": "object",
      "description": "P11: Highest-priority safe unresolved gap from the taxonomy gap queue"
    },
    "phase": {
      "type": "string",
      "enum": [
        "discovery",
        "normalization",
        "taxonomy",
        "backend",
        "catalog",
        "validation",
        "repair",
        "harden",
        "complete"
      ],
      "default": "discovery"
    }
  },
  "required": [
    "organization_id",
    "heartbeat_time"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}