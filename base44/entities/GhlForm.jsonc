{
  "name": "GhlForm",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "funnel_id": {
      "type": "string"
    },
    "page_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "redirect_url": {
      "type": "string"
    },
    "submissions": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "funnel_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}