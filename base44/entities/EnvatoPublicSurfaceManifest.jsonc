{
  "name": "EnvatoPublicSurfaceManifest",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "source_route": {
      "type": "string",
      "description": "Canonical route path on source site"
    },
    "raw_url": {
      "type": "string",
      "description": "Original un-normalized URL before canonicalization"
    },
    "canonical_url": {
      "type": "string",
      "description": "Normalized canonical URL after trailing slash, query, tracking, locale, encoding, case normalization"
    },
    "route_type": {
      "type": "string",
      "enum": [
        "content",
        "search_state",
        "filter_state",
        "pagination_state",
        "alias",
        "redirect",
        "utility",
        "auth",
        "pricing",
        "source_404",
        "invalid",
        "other_with_evidence"
      ],
      "default": "content"
    },
    "page_type": {
      "type": "string",
      "enum": [
        "homepage",
        "category",
        "subcategory",
        "item_detail",
        "search",
        "pricing",
        "auth",
        "author",
        "collection",
        "ai_tool",
        "help",
        "legal",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "parent_route": {
      "type": "string"
    },
    "redirect_target": {
      "type": "string",
      "description": "Final destination URL if this route redirects"
    },
    "discovery_source": {
      "type": "string",
      "enum": [
        "header",
        "navigation",
        "mega_menu",
        "category",
        "subcategory",
        "search",
        "filter",
        "card",
        "item_page",
        "footer",
        "pricing",
        "auth",
        "manual",
        "normalization"
      ]
    },
    "semantic_category": {
      "type": "string"
    },
    "valid": {
      "type": "boolean",
      "default": true
    },
    "source_status": {
      "type": "string",
      "enum": [
        "ok",
        "redirect",
        "not_found",
        "blocked",
        "error",
        "unknown"
      ],
      "default": "ok"
    },
    "http_state": {
      "type": "number",
      "description": "HTTP status code"
    },
    "page_state": {
      "type": "string",
      "enum": [
        "rendered",
        "spa_shell",
        "redirect",
        "404",
        "error",
        "blocked"
      ]
    },
    "outbound_internal_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_interactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clone_route": {
      "type": "string",
      "description": "Corresponding clone route"
    },
    "clone_status": {
      "type": "string",
      "enum": [
        "missing",
        "exists",
        "validated"
      ],
      "default": "missing"
    },
    "taxonomy_validated": {
      "type": "boolean",
      "default": false,
      "description": "True when this route has been cross-referenced and confirmed against the EnvatoTaxonomyLedger"
    },
    "matched_taxonomy_node": {
      "type": "string",
      "description": "The taxonomy_node_id this route was matched against"
    },
    "taxonomy_validation_status": {
      "type": "string",
      "enum": [
        "unvalidated",
        "matched",
        "no_taxonomy_match",
        "non_content_route"
      ],
      "default": "unvalidated"
    },
    "unmatched_classification": {
      "type": "string",
      "enum": [
        "missing_taxonomy_mapping",
        "dynamic_item_detail",
        "search_state",
        "filter_state",
        "pagination_state",
        "alias",
        "redirect",
        "utility_route",
        "auth_route",
        "pricing_route",
        "source_404",
        "invalid_route",
        "other_with_evidence"
      ],
      "description": "Classification for unmatched routes \u2014 only missing_taxonomy_mapping creates a new taxonomy mapping"
    },
    "classification_evidence": {
      "type": "string",
      "description": "Evidence supporting the unmatched classification (title, H1, breadcrumbs, etc.)"
    },
    "normalized": {
      "type": "boolean",
      "default": false,
      "description": "True after route has been through canonical normalization"
    },
    "validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "source_route",
    "page_type",
    "valid"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}