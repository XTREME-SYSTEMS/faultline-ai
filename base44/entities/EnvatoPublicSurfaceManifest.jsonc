{
  "name": "EnvatoPublicSurfaceManifest",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "source_route": {
      "type": "string",
      "description": "Canonical route path on source site"
    },
    "page_type": {
      "type": "string",
      "enum": [
        "homepage",
        "category",
        "subcategory",
        "item_detail",
        "search",
        "pricing",
        "auth",
        "author",
        "collection",
        "ai_tool",
        "help",
        "legal",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "parent_route": {
      "type": "string"
    },
    "discovery_source": {
      "type": "string",
      "enum": [
        "header",
        "navigation",
        "mega_menu",
        "category",
        "subcategory",
        "search",
        "filter",
        "card",
        "item_page",
        "footer",
        "pricing",
        "auth",
        "manual"
      ]
    },
    "semantic_category": {
      "type": "string"
    },
    "valid": {
      "type": "boolean",
      "default": true
    },
    "http_state": {
      "type": "number",
      "description": "HTTP status code"
    },
    "page_state": {
      "type": "string",
      "enum": [
        "rendered",
        "spa_shell",
        "redirect",
        "404",
        "error",
        "blocked"
      ]
    },
    "outbound_internal_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_interactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clone_route": {
      "type": "string",
      "description": "Corresponding clone route"
    },
    "clone_status": {
      "type": "string",
      "enum": [
        "missing",
        "exists",
        "validated"
      ],
      "default": "missing"
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "source_route",
    "page_type",
    "valid"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}