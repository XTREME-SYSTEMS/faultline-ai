{
  "name": "Course",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_url": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}