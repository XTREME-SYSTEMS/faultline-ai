{
  "name": "MarketPrice",
  "type": "object",
  "properties": {
    "trade": {
      "type": "string",
      "description": "Trade or service looked up"
    },
    "zip_code": {
      "type": "string"
    },
    "low": {
      "type": "number"
    },
    "mid": {
      "type": "number"
    },
    "high": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "description": "e.g. per sq ft, per project"
    },
    "summary": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "chosen_range": {
      "type": "string",
      "enum": [
        "low",
        "mid",
        "high"
      ]
    },
    "adders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "final_price": {
      "type": "number"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "trade",
    "zip_code",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}