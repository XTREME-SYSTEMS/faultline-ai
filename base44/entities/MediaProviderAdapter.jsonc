{
  "name": "MediaProviderAdapter",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "supported_media_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_strategy": {
      "type": "string"
    },
    "payload_template": {
      "type": "object"
    },
    "truth_state": {
      "type": "string",
      "enum": [
        "not_configured",
        "configured",
        "tested",
        "operational",
        "failed"
      ],
      "default": "not_configured"
    },
    "last_tested_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organization_id",
    "provider_name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}