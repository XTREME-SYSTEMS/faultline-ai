{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "past_due",
        "cancelled",
        "expired"
      ],
      "default": "trial"
    },
    "setup_price": {
      "type": "number",
      "default": 0
    },
    "monthly_price": {
      "type": "number",
      "default": 0
    },
    "current_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "tool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "organization_id",
    "account_id",
    "package_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}