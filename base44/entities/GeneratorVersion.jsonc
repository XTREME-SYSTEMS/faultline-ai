{
  "name": "GeneratorVersion",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "generator_id": {
      "type": "string"
    },
    "version_number": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {}
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changelog": {
      "type": "string"
    },
    "quality_score": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "organization_id",
    "generator_id",
    "version_number"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}