{
  "name": "CostOfBusiness",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "crew_wages_annual": {
      "type": "number",
      "description": "Total crew wages per year"
    },
    "employer_tax_pct": {
      "type": "number",
      "description": "FICA/FUTA/SUTA %",
      "default": 9.15
    },
    "workers_comp_pct": {
      "type": "number",
      "description": "% of wages",
      "default": 8
    },
    "benefits_pct": {
      "type": "number",
      "description": "% of wages",
      "default": 10
    },
    "general_liability_annual": {
      "type": "number"
    },
    "commercial_auto_annual": {
      "type": "number"
    },
    "equipment_insurance_annual": {
      "type": "number"
    },
    "health_insurance_annual": {
      "type": "number"
    },
    "fuel_cost_annual": {
      "type": "number"
    },
    "vehicle_depreciation_annual": {
      "type": "number"
    },
    "vehicle_maintenance_annual": {
      "type": "number"
    },
    "equipment_depreciation_annual": {
      "type": "number"
    },
    "rent_facility_annual": {
      "type": "number"
    },
    "utilities_annual": {
      "type": "number"
    },
    "software_ai_annual": {
      "type": "number",
      "description": "Base44, design, CRM, AI tools"
    },
    "it_hardware_annual": {
      "type": "number"
    },
    "phone_internet_annual": {
      "type": "number"
    },
    "marketing_annual": {
      "type": "number"
    },
    "admin_other_annual": {
      "type": "number"
    },
    "billable_hours_per_year": {
      "type": "number",
      "default": 1500
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "company_name",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}