{
  "name": "RevenueLeak",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "annual_impact_min": {
      "type": "number"
    },
    "annual_impact_max": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    }
  },
  "required": [
    "organization_id",
    "finding_id",
    "category"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}