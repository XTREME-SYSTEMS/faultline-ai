{
  "name": "ProductEntitlement",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "subscription_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "configuration": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "account_id",
    "tool_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}