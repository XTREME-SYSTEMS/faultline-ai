{
  "name": "ClientProject",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string",
      "description": "CustomerAccount ref"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "website",
        "app",
        "ai_tool",
        "ai_company"
      ]
    },
    "project_name": {
      "type": "string"
    },
    "current_gate": {
      "type": "string",
      "description": "slug of the current gate"
    },
    "gate_index": {
      "type": "number",
      "default": 0
    },
    "total_gates": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "discovery",
        "in_review",
        "in_progress",
        "approved",
        "completed",
        "paused"
      ],
      "default": "discovery"
    },
    "discovery_responses": {
      "type": "object",
      "description": "Answers from the discovery questionnaire"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of gate slugs for this project"
    },
    "current_deliverable_id": {
      "type": "string",
      "description": "Deliverable ref presented at the current gate"
    },
    "cart_order_id": {
      "type": "string",
      "description": "Active CartOrder for upsells"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "service_type",
    "project_name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}