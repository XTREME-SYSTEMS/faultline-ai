{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "scope_summary": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "content_markdown": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved_to_send",
        "sent",
        "accepted",
        "archived"
      ],
      "default": "draft"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "lead_id",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}