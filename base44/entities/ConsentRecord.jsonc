{
  "name": "ConsentRecord",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "email",
        "voice",
        "push"
      ]
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "revoked",
        "pending"
      ],
      "default": "pending"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "account_id",
    "channel"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}