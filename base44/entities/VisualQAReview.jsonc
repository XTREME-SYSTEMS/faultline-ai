{
  "name": "VisualQAReview",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "review_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "approved",
        "revise",
        "rejected"
      ]
    },
    "score": {
      "type": "number"
    },
    "rule_results": {
      "type": "array",
      "items": {}
    },
    "qa_note": {
      "type": "string"
    },
    "reviewer_type": {
      "type": "string",
      "enum": [
        "ai",
        "human",
        "hybrid"
      ],
      "default": "hybrid"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "asset_id",
    "overall_status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}