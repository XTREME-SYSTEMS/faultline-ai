{
  "name": "WorkflowRun",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "workflow_name": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "output": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "workflow_name",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}