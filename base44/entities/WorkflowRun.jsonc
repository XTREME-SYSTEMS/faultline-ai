{
  "name": "WorkflowRun",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "queue_item_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "current_step": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "logs": {
      "type": "array",
      "items": {}
    },
    "output_refs": {
      "type": "object"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "workflow_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}