{
  "name": "ClientPortalConfig",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "portal_name": {
      "type": "string"
    },
    "welcome_message": {
      "type": "string"
    },
    "expose_findings": {
      "type": "boolean",
      "default": true
    },
    "expose_repair_plans": {
      "type": "boolean",
      "default": true
    },
    "expose_reports": {
      "type": "boolean",
      "default": true
    },
    "expose_health_score": {
      "type": "boolean",
      "default": true
    },
    "guide_tone": {
      "type": "string",
      "default": "warm"
    },
    "guide_focus": {
      "type": "string"
    },
    "setup_complete": {
      "type": "boolean",
      "default": false
    },
    "current_phase": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "company_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}