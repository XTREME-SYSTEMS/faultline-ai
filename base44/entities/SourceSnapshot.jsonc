{
  "name": "SourceSnapshot",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "snapshot_type": {
      "type": "string",
      "description": "product_catalog_refresh, price_check, course_catalog, etc"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Completed",
        "Failed",
        "Stale"
      ],
      "default": "Pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "source_name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}