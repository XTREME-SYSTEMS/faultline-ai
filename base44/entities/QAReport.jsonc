{
  "name": "QAReport",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "deliverable",
        "plan",
        "finding",
        "system",
        "website",
        "workflow",
        "universal_plan",
        "repair_plan",
        "outreach",
        "general"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "target_title": {
      "type": "string"
    },
    "check_type": {
      "type": "string",
      "enum": [
        "qa_validation",
        "headless_test",
        "security_compliance"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "warnings"
      ],
      "default": "passed"
    },
    "score": {
      "type": "number"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compliance_frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_generated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "organization_id",
    "target_type",
    "check_type",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}