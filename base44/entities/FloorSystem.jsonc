{
  "name": "FloorSystem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "epoxy",
        "polished_concrete",
        "decorative_concrete",
        "coating",
        "specialty"
      ]
    },
    "description": {
      "type": "string"
    },
    "finishes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available finish options (sheen levels)"
    },
    "sheen_levels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Matte",
          "Satin",
          "Semi-Gloss",
          "High Gloss",
          "Wet Look",
          "Textured"
        ]
      },
      "description": "Standardized sheen levels available for this system"
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "product_skus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SKUs of products used in this system build"
    },
    "base_rate_low": {
      "type": "number",
      "description": "USD per sq ft low"
    },
    "base_rate_high": {
      "type": "number",
      "description": "USD per sq ft high"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "organization_id": {
      "type": "string",
      "description": "Tenant organization id"
    }
  },
  "required": [
    "name",
    "category",
    "base_rate_low",
    "base_rate_high",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}