{
  "name": "SystemEdge",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "source_node_id": {
      "type": "string"
    },
    "target_node_id": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "risk_status": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "source_node_id",
    "target_node_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}