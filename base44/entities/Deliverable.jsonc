{
  "name": "Deliverable",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "deliverable_type": {
      "type": "string",
      "enum": [
        "client_proposal",
        "website",
        "brand",
        "cost_roi",
        "ai_operating_system"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "default": "generated"
    }
  },
  "required": [
    "organization_id",
    "deliverable_type",
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}