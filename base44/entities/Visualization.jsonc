{
  "name": "Visualization",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "option_index": {
      "type": "number",
      "description": "1, 2 or 3"
    },
    "label": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "source_photo_url": {
      "type": "string"
    },
    "system_name": {
      "type": "string"
    },
    "finish": {
      "type": "string"
    },
    "color_name": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "selected": {
      "type": "boolean",
      "default": false
    },
    "disclosure": {
      "type": "string",
      "default": "AI concept visualization, not a completed customer project."
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "image_url",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}