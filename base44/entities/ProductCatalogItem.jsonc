{
  "name": "ProductCatalogItem",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string",
      "description": "External product SKU or ID"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "compare_at": {
      "type": "number",
      "description": "Original price for sale items"
    },
    "unit": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_name": {
      "type": "string",
      "description": "e.g. Xtreme Polishing Systems"
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "discontinued",
        "price_changed"
      ],
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "name",
    "price"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}