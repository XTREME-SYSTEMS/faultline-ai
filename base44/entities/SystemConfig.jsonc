{
  "name": "SystemConfig",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_location": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "target_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_industries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposal_summary": {
      "type": "string"
    },
    "email_style": {
      "type": "string"
    },
    "discovery_criteria": {
      "type": "string"
    },
    "audit_depth": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "deep"
      ],
      "default": "standard"
    },
    "scrape_frequency": {
      "type": "string",
      "default": "daily"
    },
    "email_automation": {
      "type": "boolean",
      "default": false
    },
    "diagnostics_enabled": {
      "type": "object"
    },
    "current_phase": {
      "type": "number",
      "default": 0
    },
    "setup_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}