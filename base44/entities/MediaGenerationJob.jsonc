{
  "name": "MediaGenerationJob",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ]
    },
    "source_asset_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "queued",
        "running",
        "awaiting_provider",
        "failed",
        "completed",
        "qa_required",
        "approved",
        "rejected"
      ],
      "default": "draft"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "max_attempts": {
      "type": "number",
      "default": 3
    },
    "provider_job_id": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "prompt_id",
    "provider_id",
    "media_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}