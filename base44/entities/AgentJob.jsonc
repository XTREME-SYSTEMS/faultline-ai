{
  "name": "AgentJob",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "job_type": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string"
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "not_required"
      ],
      "default": "not_required"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "claimed",
        "running",
        "completed",
        "failed",
        "quarantined"
      ],
      "default": "queued"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "max_attempts": {
      "type": "number",
      "default": 3
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "output_refs": {
      "type": "object"
    },
    "error": {
      "type": "string"
    },
    "priority": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "project_id",
    "agent_type",
    "job_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}