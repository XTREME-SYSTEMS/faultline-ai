{
  "name": "Audit",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "audit_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "report_url": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "company_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}