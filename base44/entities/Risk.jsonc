{
  "name": "Risk",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "likelihood": {
      "type": "number"
    },
    "impact": {
      "type": "number"
    },
    "controls": {
      "type": "array"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "finding_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}