{
  "name": "Website",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "last_scanned_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "company_id",
    "url"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}