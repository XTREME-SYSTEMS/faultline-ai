{
  "name": "ToolProduct",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "business_problem": {
      "type": "string"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "included_generators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "package_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price_mode": {
      "type": "string",
      "enum": [
        "Quote",
        "A La Carte",
        "Package"
      ],
      "default": "A La Carte"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Ready"
      ],
      "default": "Draft"
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}