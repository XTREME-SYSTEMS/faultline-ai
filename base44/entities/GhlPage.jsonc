{
  "name": "GhlPage",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "funnel_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "page_type": {
      "type": "string",
      "enum": [
        "landing",
        "thank_you",
        "optin"
      ],
      "default": "landing"
    },
    "html": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "organization_id",
    "funnel_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}