{
  "name": "FinishProfile",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "finish_id": {
      "type": "string",
      "description": "Unique finish identifier"
    },
    "name": {
      "type": "string"
    },
    "family": {
      "type": "string",
      "description": "e.g. Polished Concrete, Epoxy, Polyaspartic"
    },
    "stage": {
      "type": "string"
    },
    "surface_description": {
      "type": "string"
    },
    "sheen": {
      "type": "string"
    },
    "installation_details": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "realism_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "positive_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organization_id",
    "name",
    "family"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}