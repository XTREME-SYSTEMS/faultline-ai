{
  "name": "EnvatoTaxonomyLedger",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "taxonomy_node_id": {
      "type": "string",
      "description": "Unique ID for this taxonomy node"
    },
    "node_type": {
      "type": "string",
      "enum": [
        "root",
        "category",
        "subcategory",
        "asset_class",
        "tag",
        "software",
        "format",
        "style",
        "use_case",
        "filter_family",
        "sort_mode",
        "content_type"
      ]
    },
    "node_name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe slug derived from node_name, used for route matching"
    },
    "parent_node": {
      "type": "string",
      "description": "Parent taxonomy node ID"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent taxonomy node ID (graph field \u2014 alias of parent_node)"
    },
    "ancestors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of ancestor taxonomy node IDs from root to parent"
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of direct child taxonomy node IDs"
    },
    "source_route": {
      "type": "string",
      "description": "Canonical source route that maps to this taxonomy node"
    },
    "clone_route": {
      "type": "string",
      "description": "Corresponding clone route"
    },
    "filter_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Filter dimension node IDs applicable to this node"
    },
    "content_count": {
      "type": "number",
      "default": 0
    },
    "source_present": {
      "type": "boolean",
      "default": false
    },
    "clone_present": {
      "type": "boolean",
      "default": false
    },
    "clone_supported": {
      "type": "boolean",
      "default": false
    },
    "content_available": {
      "type": "boolean",
      "default": false
    },
    "searchable": {
      "type": "boolean",
      "default": false
    },
    "filterable": {
      "type": "boolean",
      "default": false
    },
    "tested": {
      "type": "boolean",
      "default": false
    },
    "source_evidence": {
      "type": "string"
    },
    "clone_implementation": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "description": "0-1 confidence score for this node's classification",
      "default": 0.5
    },
    "orphan_classification": {
      "type": "string",
      "enum": [
        "valid_leaf_not_discovered",
        "valid_parent_group",
        "filter_only_dimension",
        "alias",
        "duplicate",
        "stale",
        "invalid",
        "out_of_scope",
        "missing_content",
        "missing_route",
        "missing_crawl_evidence",
        "not_orphan"
      ],
      "description": "Classification for orphan taxonomy nodes \u2014 determines whether the node requires a standalone page"
    },
    "classification_evidence": {
      "type": "string",
      "description": "Evidence supporting the orphan classification"
    },
    "status": {
      "type": "string",
      "enum": [
        "missing",
        "discovered",
        "implemented",
        "validated"
      ],
      "default": "missing"
    },
    "taxonomy_truth_class": {
      "type": "string",
      "enum": [
        "official_navigable_taxonomy",
        "filter_dimension",
        "search_term_landing",
        "seo_landing",
        "tag_landing",
        "item_detail",
        "similar_item_route",
        "dynamic_state",
        "alias",
        "invalid_garbage",
        "other_with_evidence"
      ],
      "description": "P0-5: Truth class \u2014 only official_navigable_taxonomy participates in TAXONOMY_ROUTE_COVERAGE and CONTENT_FAMILY_COVERAGE",
      "default": "other_with_evidence"
    },
    "content_family": {
      "type": "string",
      "description": "Content family name for this taxonomy node"
    }
  },
  "required": [
    "organization_id",
    "taxonomy_node_id",
    "node_type",
    "node_name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}