{
  "name": "EnvatoTaxonomyLedger",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "taxonomy_node_id": {
      "type": "string",
      "description": "Unique ID for this taxonomy node"
    },
    "node_type": {
      "type": "string",
      "enum": [
        "category",
        "subcategory",
        "asset_class",
        "tag",
        "software",
        "format",
        "style",
        "theme",
        "use_case",
        "filter_family",
        "sort_mode",
        "content_type"
      ]
    },
    "node_name": {
      "type": "string"
    },
    "parent_node": {
      "type": "string",
      "description": "Parent taxonomy node ID"
    },
    "source_present": {
      "type": "boolean",
      "default": false
    },
    "clone_present": {
      "type": "boolean",
      "default": false
    },
    "clone_supported": {
      "type": "boolean",
      "default": false
    },
    "content_available": {
      "type": "boolean",
      "default": false
    },
    "content_count": {
      "type": "number",
      "default": 0
    },
    "searchable": {
      "type": "boolean",
      "default": false
    },
    "filterable": {
      "type": "boolean",
      "default": false
    },
    "tested": {
      "type": "boolean",
      "default": false
    },
    "source_evidence": {
      "type": "string"
    },
    "clone_implementation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "missing",
        "discovered",
        "implemented",
        "validated"
      ],
      "default": "missing"
    }
  },
  "required": [
    "organization_id",
    "taxonomy_node_id",
    "node_type",
    "node_name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}