{
  "name": "GeneratorDefinition",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "build_type": {
      "type": "string",
      "enum": [
        "Single Generator",
        "Multi-Generator Workflow",
        "AI Tool",
        "Website",
        "Application",
        "End-to-End Business System"
      ]
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "current_version_id": {
      "type": "string"
    },
    "quality_score": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string",
      "default": "0.1.0"
    },
    "created_by": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Optional link to a BusinessProject"
    }
  },
  "required": [
    "organization_id",
    "name",
    "build_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}