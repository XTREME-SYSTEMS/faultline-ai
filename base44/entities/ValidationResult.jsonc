{
  "name": "ValidationResult",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "description": "completeness, consistency, usability, source, quality"
    },
    "check_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "warn",
        "skip"
      ],
      "default": "pass"
    },
    "score": {
      "type": "number",
      "default": 100
    },
    "evidence": {
      "type": "object"
    },
    "failure_class": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "area",
    "check_name",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}