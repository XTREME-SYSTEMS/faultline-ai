{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "pcu_graduate": {
      "type": "boolean",
      "default": false
    },
    "graduation_date": {
      "type": "string",
      "format": "date"
    },
    "courses_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_name": {
      "type": "string"
    },
    "business_stage": {
      "type": "string",
      "enum": [
        "pre_launch",
        "launching",
        "established",
        "scaling"
      ],
      "default": "pre_launch"
    },
    "industry": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "recommended_tool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "purchased_tool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "organization_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}