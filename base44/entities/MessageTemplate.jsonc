{
  "name": "MessageTemplate",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "clarification",
        "proposal_delivery",
        "viewed_no_response",
        "reminder",
        "objection",
        "revised_proposal",
        "acceptance_confirmation",
        "signature_reminder",
        "deposit_reminder",
        "lost_feedback"
      ]
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "sent",
        "archived"
      ],
      "default": "draft"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "template_type",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}