{
  "name": "BrandAsset",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Uploaded or AI-generated logo"
    },
    "brand_direction": {
      "type": "string",
      "enum": [
        "revenue_gold",
        "clarity_white",
        "closing_room"
      ],
      "default": "revenue_gold"
    },
    "primary_color": {
      "type": "string",
      "default": "#0A0A0A"
    },
    "accent_color": {
      "type": "string",
      "default": "#F5C542"
    },
    "tagline": {
      "type": "string"
    },
    "email_signature": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    }
  },
  "required": [
    "company_name",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}